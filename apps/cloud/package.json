{
  "name": "@sharebin/cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "bun run typecheck:backend && bun run typecheck:frontend",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p ../../packages/frontend/tsconfig.json --noEmit",
    "lint": "eslint src ../../packages/frontend/src"
  },
  "dependencies": {
    "@sharebin/shared": "workspace:*",
    "hono": "^4.12.18",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260509.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@sharebin/frontend": "workspace:*",
    "codemirror": "^6.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6"
  }
}

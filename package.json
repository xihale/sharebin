{
  "name": "sharebin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cloud": "bun run --filter @sharebin/cloud dev",
    "dev:selfhost": "bun run --filter @sharebin/selfhost dev",
    "build:cloud": "bun run --filter @sharebin/cloud build",
    "build:selfhost": "bun run --filter @sharebin/selfhost build",
    "deploy:cloud": "bun run --filter @sharebin/cloud deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6"
  }
}
